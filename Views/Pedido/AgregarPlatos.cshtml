@model Pedido
@{
    ViewData["Title"] = "Agregar platos al pedido";
    var platos = (List<Plato>)ViewBag.Platos;
    int i = 0;
}

<h2>Agregar platos a PED-@Model.Id</h2>
<p class="text-muted">Mesa @Model.MesaNumero · Estado: EN PREPARACIÓN</p>
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<form asp-action="AgregarPlatos" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead><tr><th>Plato</th><th>Precio</th><th style="width:130px">Cantidad</th><th>Nota</th></tr></thead>
            <tbody>
            @foreach (var p in platos)
            {
                <tr>
                    <td>@p.Nombre</td>
                    <td>S/ @p.Precio.ToString("0.00")</td>
                    <td>
                        <input type="hidden" name="Detalles[@i].PlatoId" value="@p.Id" />
                        <input type="number" name="Detalles[@i].Cantidad" min="0" max="50" value="0" class="form-control qty" data-precio="@p.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                    </td>
                    <td><input type="text" name="Detalles[@i].Notas" maxlength="255" class="form-control" /></td>
                </tr>
                i++;
            }
            </tbody>
        </table>
    </div>
    <h4>Importe adicional: <span id="total">S/ 0.00</span></h4>
    <button type="submit" class="btn btn-primary">Agregar al pedido y enviar a cocina</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
</form>

@section Scripts {
<script>
    function recalcular() {
        var total = 0;
        document.querySelectorAll('.qty').forEach(function (q) {
            total += (parseInt(q.value) || 0) * parseFloat(q.dataset.precio);
        });
        document.getElementById('total').textContent = 'S/ ' + total.toFixed(2);
    }
    document.querySelectorAll('.qty').forEach(function (q) { q.addEventListener('input', recalcular); });
</script>
}
