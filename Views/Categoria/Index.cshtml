@model List<Categoria>

<h2>Lista de Categorías</h2>
<a asp-action="Create">Crear Nueva Categoría</a>
<table border="1">
    <tr>
        <th>Nombre</th>
        <th>Descripción</th>
        <th>Platos</th>
        <th>Activa</th>
        <th>Acciones</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Nombre</td>
            <td>@item.Descripcion</td>
            <td>@item.CantidadPlatos</td>
            <td>@(item.Activa ? "Sí" : "No")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline" onsubmit="return confirm('¿Eliminar la categoría?');"><button type="submit">Eliminar</button></form>
            </td>
        </tr>
    }
</table>
