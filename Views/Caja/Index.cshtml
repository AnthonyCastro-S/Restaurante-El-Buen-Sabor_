@model List<Cuenta>
@{ ViewData["Title"] = "Caja"; bool abierta = ViewBag.SesionId != null; }
<div class="page-heading"><div><span class="section-kicker">OPERACIONES</span><h1>Caja y cobros</h1><p>Administra los pagos, movimientos y arqueos del turno.</p></div><div class="heading-actions"><a asp-action="Historial" class="btn btn-light">Historial de cierres</a>@if (abierta) { <a asp-action="Cierre" class="btn btn-dark">Realizar cierre</a> } else { <a asp-action="Apertura" class="btn btn-primary">Abrir caja</a> }</div></div>
@if (abierta) { <div class="cash-status"><span class="status-dot"></span><div><strong>Caja abierta</strong><small>Desde @(((DateTime)ViewBag.FechaApertura).ToString("dd/MM/yyyy HH:mm")) · Fondo inicial S/ @(((decimal)ViewBag.MontoInicial).ToString("N2"))</small></div><a asp-action="Cierre">Cerrar turno →</a></div> } else { <div class="cash-status closed"><span class="status-dot"></span><div><strong>No hay una caja abierta</strong><small>Abre una caja para comenzar a registrar cobros.</small></div><a asp-action="Apertura">Abrir caja →</a></div> }
<div class="panel-card mb-4"><div class="panel-title"><div><h3>Cuentas por cobrar</h3><p>Mesas con pedidos entregados pendientes de pago</p></div><span class="count-chip">@Model.Count cuentas</span></div>
@if (Model.Any()) { <div class="table-responsive"><table><thead><tr><th>Mesa</th><th>Pedidos</th><th>Subtotal</th><th>IGV</th><th>Total</th><th>Acción</th></tr></thead><tbody>@foreach (var c in Model) { <tr><td><strong>Mesa @c.MesaNumero</strong></td><td>@c.CantidadPedidos</td><td>S/ @c.Subtotal.ToString("N2")</td><td>S/ @c.Igv.ToString("N2")</td><td><strong>S/ @c.Total.ToString("N2")</strong></td><td><a asp-action="GenerarCuenta" asp-route-id="@c.MesaId" class="btn btn-sm btn-outline-primary">Ver cuenta</a></td></tr> }</tbody></table></div> } else { <div class="empty-state"><span>✓</span><strong>No hay cuentas pendientes</strong><p>Las cuentas aparecerán aquí cuando los pedidos sean entregados.</p></div> }</div>
@if (abierta) { <div class="panel-card"><div class="panel-title"><div><h3>Registrar movimiento de caja</h3><p>Registra ingresos o egresos adicionales del turno.</p></div></div><form asp-action="Movimiento" method="post" class="row g-3 align-items-end">@Html.AntiForgeryToken()<div class="col-md-3"><label>Tipo</label><select name="tipo" class="form-select"><option value="EGRESO">Egreso</option><option value="INGRESO">Ingreso</option></select></div><div class="col-md-5"><label>Concepto</label><input name="concepto" class="form-control" required maxlength="200" placeholder="Ej. Compra de insumos" /></div><div class="col-md-2"><label>Importe (S/)</label><input name="importe" type="number" min="0.01" step="0.01" class="form-control" required /></div><div class="col-md-2"><button class="btn btn-primary w-100">Registrar</button></div></form></div> }
