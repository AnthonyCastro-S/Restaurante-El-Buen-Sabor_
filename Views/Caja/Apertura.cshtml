@{ ViewData["Title"] = "Apertura de caja"; }
<div class="page-heading"><div><span class="section-kicker">CONTROL DE CAJA</span><h1>Apertura de caja</h1><p>Registra el fondo inicial disponible para comenzar el turno.</p></div><a asp-action="Index" class="btn btn-light">Volver</a></div>
<div class="panel-card form-panel"><form asp-action="Apertura" method="post">@Html.AntiForgeryToken()<div class="form-intro"><span class="stat-icon orange">S/</span><div><h3>Fondo inicial</h3><p>Ingresa el efectivo con el que inicia el turno.</p></div></div><label for="montoInicial">Monto inicial (S/)</label><input id="montoInicial" name="montoInicial" type="number" class="form-control form-control-lg" min="0" step="0.01" value="0.00" required /><div class="form-actions"><a asp-action="Index" class="btn btn-light">Cancelar</a><button class="btn btn-primary">Confirmar apertura</button></div></form></div>
