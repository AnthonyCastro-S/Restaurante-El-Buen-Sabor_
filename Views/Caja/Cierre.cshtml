@{ ViewData["Title"] = "Cierre de caja"; decimal inicial = Convert.ToDecimal(ViewBag.MontoInicial); decimal efectivo = Convert.ToDecimal(ViewBag.VentasEfectivo); decimal movimientos = Convert.ToDecimal(ViewBag.Movimientos); decimal esperado = inicial + efectivo + movimientos; }
<div class="page-heading"><div><span class="section-kicker">CONTROL DE CAJA</span><h1>Cierre y arqueo</h1><p>Verifica el efectivo disponible y registra el resultado del turno.</p></div><a asp-action="Index" class="btn btn-light">Volver</a></div>
<div class="closing-grid"><div class="panel-card"><div class="panel-title"><div><h3>Resumen del turno</h3><p>Apertura: @(((DateTime)ViewBag.FechaApertura).ToString("dd/MM/yyyy HH:mm"))</p></div></div><div class="operation-line"><span>Fondo inicial</span><strong>S/ @inicial.ToString("N2")</strong></div><div class="operation-line"><span>Ventas en efectivo</span><strong>S/ @efectivo.ToString("N2")</strong></div><div class="operation-line"><span>Movimientos netos</span><strong>S/ @movimientos.ToString("N2")</strong></div><div class="expected-total"><span>Efectivo esperado</span><strong>S/ @esperado.ToString("N2")</strong></div><p class="muted-note">Los pagos con tarjeta y Yape/Plin no forman parte del efectivo esperado.</p></div>
<div class="panel-card"><form asp-action="Cierre" method="post" id="formCierre">@Html.AntiForgeryToken()<h3>Arqueo de efectivo</h3><p class="muted-note">Cuenta el efectivo físico e ingresa el monto total.</p><label for="efectivoContado">Efectivo contado (S/)</label><input id="efectivoContado" name="efectivoContado" type="number" min="0" step="0.01" value="@esperado.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-lg" required /><div class="difference-preview">Diferencia estimada <strong id="diferencia">S/ 0.00</strong></div><label for="observaciones" class="mt-3">Observaciones</label><textarea id="observaciones" name="observaciones" class="form-control" rows="3" maxlength="500" placeholder="Detalle cualquier diferencia o incidencia"></textarea><button class="btn btn-dark w-100 mt-4" type="submit" onclick="return confirm('¿Confirmas el cierre de caja? Esta acción no se puede deshacer.')">Confirmar cierre de caja</button></form></div></div>
@section Scripts { <script>const esperado=@esperado.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture);const campo=document.getElementById('efectivoContado');function actualizar(){const dif=Number(campo.value||0)-esperado;const el=document.getElementById('diferencia');el.textContent=(dif>=0?'+':'')+' S/ '+dif.toFixed(2);el.className=dif===0?'balanced':dif>0?'surplus':'shortage';}campo.addEventListener('input',actualizar);actualizar();</script> }
