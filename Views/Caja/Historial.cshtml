@model List<dynamic>
@{ ViewData["Title"] = "Historial de caja"; }
<div class="page-heading"><div><span class="section-kicker">CONTROL DE CAJA</span><h1>Historial de cierres</h1><p>Consulta los arqueos y resultados de los turnos anteriores.</p></div><a asp-action="Index" class="btn btn-light">Volver a caja</a></div>
<div class="panel-card"><div class="panel-title"><div><h3>Turnos registrados</h3><p>Últimos 30 cierres y aperturas</p></div></div>@if (Model.Any()) { <div class="table-responsive"><table><thead><tr><th>Turno</th><th>Cajero</th><th>Apertura</th><th>Cierre</th><th>Fondo inicial</th><th>Contado</th><th>Diferencia</th><th>Estado</th></tr></thead><tbody>@foreach (var x in Model) { <tr><td>#@x.Id</td><td>@x.Cajero</td><td>@(((DateTime)x.Apertura).ToString("dd/MM HH:mm"))</td><td>@(x.Cierre == DBNull.Value ? "—" : ((DateTime)x.Cierre).ToString("dd/MM HH:mm"))</td><td>S/ @Convert.ToDecimal(x.Inicial).ToString("N2")</td><td>@(x.Contado == DBNull.Value ? "—" : "S/ "+Convert.ToDecimal(x.Contado).ToString("N2"))</td><td>@(x.Diferencia == DBNull.Value ? "—" : "S/ "+Convert.ToDecimal(x.Diferencia).ToString("N2"))</td><td><span class="state-pill @(x.Estado=="ABIERTA"?"open":"closed")">@x.Estado</span></td></tr> }</tbody></table></div> } else { <div class="empty-state"><strong>Aún no hay cierres registrados</strong></div> }</div>
