@model ElBuenSabor.Models.Insumo
@{ ViewData["Title"] = "Registrar movimiento"; }
<h2>Movimiento de inventario</h2>
<div class="card mb-3" style="max-width:600px"><div class="card-body"><div class="text-muted small">Insumo</div><h4>@Model.Nombre</h4><p class="mb-0">Stock actual: <strong>@Model.StockActual.ToString("N2") @Model.Unidad</strong> · Mínimo: @Model.StockMinimo.ToString("N2") @Model.Unidad</p></div></div>
<form asp-action="Movimiento" method="post" class="simple-form">
    <input type="hidden" name="id" value="@Model.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label>Tipo de movimiento</label><select name="tipo" class="form-select" required><option value="ENTRADA">Entrada de stock</option><option value="SALIDA">Salida de stock</option><option value="AJUSTE">Ajustar stock a una cantidad exacta</option></select></div>
    <div class="mb-3"><label>Cantidad</label><input name="cantidad" type="number" min="0.01" step="0.01" class="form-control" required /></div>
    <div class="mb-3"><label>Motivo</label><textarea name="motivo" class="form-control" maxlength="255" rows="3" required></textarea></div>
    <div class="d-flex gap-2"><button type="submit" class="btn btn-primary">Registrar movimiento</button><a asp-action="Index" class="btn btn-light">Cancelar</a></div>
</form>
